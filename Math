from fpdf import FPDF

# Initialize PDF
pdf = FPDF(format='A4')
pdf.set_auto_page_break(auto=True, margin=15)
pdf.set_font("Arial", size=12)

# Flashcard content for Sec 2 Math - simplified examples
flashcards = {
    "Algebra": [
        {"q": "Expand: (x + 3)(x - 2)", "a": "Step 1: x*x = x^2\nStep 2: x*(-2) = -2x\nStep 3: 3*x = 3x\nStep 4: 3*(-2) = -6\nAnswer: x^2 + x - 6"},
        {"q": "Factorise: x^2 + 5x + 6", "a": "Find two numbers that multiply to 6 and add to 5: 2 and 3\nAnswer: (x + 2)(x + 3)"}
    ],
    "Linear Graphs": [
        {"q": "Find gradient: line through (1,2) and (3,6)", "a": "m = (6-2)/(3-1) = 4/2 = 2"},
        {"q": "Equation of line: y-intercept 1, gradient 2", "a": "y = 2x + 1"}
    ],
    "Geometry": [
        {"q": "Pythagoras: Find hypotenuse of right triangle sides 3,4", "a": "c^2 = 3^2 + 4^2 = 9+16=25\nc=5"}
    ],
    "Mensuration": [
        {"q": "Area of rectangle: l=5, w=3", "a": "Area = l*w = 5*3=15"},
        {"q": "Volume of cube: side=4", "a": "V = s^3 = 4^3 = 64"}
    ],
    "Ratio, Rate & Proportion": [
        {"q": "Divide 12 in ratio 2:1", "a": "Total parts = 2+1=3\n2 parts: 8, 1 part: 4"},
        {"q": "Speed = distance/time, find speed if d=60km, t=2h", "a": "Speed = 60/2 = 30 km/h"}
    ],
    "Percentages": [
        {"q": "Increase 200 by 10%", "a": "200 + 10%*200 = 220"},
        {"q": "Decrease 150 by 20%", "a": "150 - 20%*150 = 120"}
    ],
    "Probability & Statistics": [
        {"q": "Probability of rolling a 3 on a die", "a": "1/6"},
        {"q": "Mean of 2,3,5,7", "a": "Mean = (2+3+5+7)/4 = 17/4 = 4.25"}
    ],
    "Number & Operations": [
        {"q": "Simplify: 2^3 * 2^2", "a": "2^3*2^2 = 2^(3+2) = 2^5 = 32"},
        {"q": "Convert 0.75 to fraction", "a": "0.75 = 75/100 = 3/4"}
    ]
}

# Generate PDF flashcards
for topic, cards in flashcards.items():
    for card in cards:
        pdf.add_page()
        # Question (top half)
        pdf.set_y(15)
        pdf.set_font("Arial", "B", 14)
        pdf.multi_cell(0, 8, f"Topic: {topic}\n\nQ: {card['q']}")
        # Answer (bottom half, upside-down)
        pdf.set_y(150)
        pdf.set_font("Arial", "", 12)
        pdf.multi_cell(0, 8, f"Answer (Flip Card):\n{card['a']}")

# Save PDF
file_path = "/mnt/data/Sec2_Math_Flashcards.pdf"
pdf.output(file_path)
file_path
